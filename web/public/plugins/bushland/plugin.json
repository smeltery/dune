{
	"id": "bushland",
	"name": "Bushland",
	"version": "1.0.0",
	"description": "Bushland — earthy, calm and cozy. Palette from https://github.com/michael-andreuzza/bushland (MIT), by Michael Andreuzza.",
	"themes": [
		{
			"id": "bushland",
			"name": "Bushland",
			"ui": {
				"bg": "#313531",
