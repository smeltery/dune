				"barBg": "#313531",
				"statusBg": "#d99e63",
				"statusFg": "#313531",
				"text": "#969896",
				"dim": "#7a7c7a",
				"faint": "#5e625e",
				"accent": "#d99e63",
				"activeTabFg": "#edd1b5",
				"inactiveTabFg": "#d7dad7",
				"treeSelectedBg": "#5a605a",
				"treeFocusBg": "#3e433e",
				"dirty": "#d99e63",
				"error": "#fd6043",
				"folder": "#969896",
				"cursor": "#7d7f73",
				"scrollbar": "#575b57",
				"gutter": "#5e625e",
				"currentLine": "#3b3f3b",
				"indentGuide": "#636763",
				"gitAdded": "#fd6043",
				"gitModified": "#d99e63",
				"gitDeleted": "#d7dad7"
			},
			"syntax": {
				"comment": { "fg": "#7d7f73", "italic": true },
				"keyword": { "fg": "#fea090" },
				"string": { "fg": "#d3b58f" },
				"number": { "fg": "#d99e63" },
